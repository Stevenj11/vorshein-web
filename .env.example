# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Powers Vorshein AI with real reasoning (Google Gemini). Get a free key at
# https://aistudio.google.com/apikey — no key set falls back to the
# rule-based demo engine automatically (see src/app/api/concierge/route.ts).
GEMINI_API_KEY=

# Sends the GEN 001 application lifecycle emails (Resend). Get a free key at
# https://resend.com/api-keys — no key set just skips email sending silently
# (see src/lib/emails/send.ts). Sandbox mode (no verified domain) only
# delivers to the account's own signup address.
RESEND_API_KEY=

# Password for the Command Center admin area (src/lib/adminAuth.ts).
# Required — the Command Center refuses all logins without it set.
ADMIN_PASSWORD=

# Required in production. Applications/members/payments/attendance/generation
# data is stored as JSON (see src/lib/jsonStore.ts) — local dev writes to
# ./data, but Vercel's serverless filesystem is read-only outside /tmp, so
# without this the very first write (e.g. submitting an application) 500s.
# In the Vercel dashboard: Storage tab -> Create Database -> Blob. It sets
# this env var for you automatically once connected to the project.
BLOB_READ_WRITE_TOKEN=
